{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "paths": {
      "@auth/*": ["./src/app/auth/*"],
      "@dashboard/*": ["./src/app/admin-dashboard/*"],
      "@products/*": ["./src/app/products/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@store-front/*": ["./src/app/store-front/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}